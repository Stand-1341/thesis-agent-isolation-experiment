# TLS termination for one private VM workload route.
# Renderer substitutes the route NIC address before installation.
server {
    listen __VM_PRIVATE_IP__:443 ssl;
    server_name __VM_PRIVATE_IP__;
    ssl_certificate /etc/thesis-agent/tls/agent.crt;
    ssl_certificate_key /etc/thesis-agent/tls/agent.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
    }
}
