{
  "name": "azure-thesis-containment-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"for(const f of ['network-probe.mjs','azure-blob-workload.mjs','azure-managed-token.mjs','azure-delegated-token.mjs','azure-session-seed.mjs','azure-keyvault-secret.mjs']) require('node:fs').copyFileSync('scripts/'+f,'dist/'+f)\"",
    "test": "npm run build && node --test --test-concurrency=1 scripts/*.test.mjs",
    "test:watch": "node --test --watch scripts/*.test.mjs",
    "verify": "npm test",
    "start:agent": "node dist/agent.js",
    "start:resource": "node dist/resource.js",
    "start:collector": "node dist/collector.js",
    "smoke": "node scripts/local-smoke.mjs",
    "plan": "node scripts/plan.mjs",
    "run:experiment": "node scripts/run-experiment-cli.mjs",
    "check:deploy": "node scripts/run-experiment-cli.mjs --config config/experiment.example.json --dry-run",
    "smoke:live": "node scripts/live-deployment-smoke.mjs",
    "run:aci-p1-pilot": "node scripts/run-aci-p1-pilot.mjs",
    "azure:inventory": "node scripts/azure-inventory.mjs",
    "sandbox:first-light": "node scripts/sandbox-first-light.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@azure/identity": "4.14.1"
  }
}