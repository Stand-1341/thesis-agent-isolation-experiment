{
  "name": "azure-thesis-containment-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"for(const f of ['network-probe.mjs','azure-blob-workload.mjs','azure-managed-token.mjs','azure-delegated-token.mjs','azure-session-seed.mjs']) require('node:fs').copyFileSync('scripts/'+f,'dist/'+f)\"",
    "start:agent": "node dist/agent.js",
    "start:resource": "node dist/resource.js",
    "start:collector": "node dist/collector.js",
    "smoke": "node scripts/local-smoke.mjs",
    "plan": "node scripts/plan.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@azure/identity": "4.14.1"
  }
}
