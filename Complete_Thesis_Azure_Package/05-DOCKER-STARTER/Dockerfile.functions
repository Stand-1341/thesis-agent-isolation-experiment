# Dedicated Functions runtime image; different host, shared scenario engine.
FROM mcr.microsoft.com/azure-functions/node:4-node22
ENV AzureWebJobsScriptRoot=/home/site/wwwroot \
    FUNCTIONS_WORKER_RUNTIME=node \
    AzureFunctionsJobHost__Logging__Console__IsEnabled=true \
    NODE_EXTRA_CA_CERTS=/home/site/wwwroot/certs/thesis-pilot-ca.pem
COPY functions/host.json /home/site/wwwroot/host.json
COPY functions/package.json /home/site/wwwroot/package.json
COPY functions/package-lock.json /home/site/wwwroot/package-lock.json
COPY certs/thesis-pilot-ca.pem /home/site/wwwroot/certs/thesis-pilot-ca.pem
COPY functions/index.mjs /home/site/wwwroot/index.mjs
COPY dist /home/site/wwwroot/dist
WORKDIR /home/site/wwwroot
# npm ci, not npm install: the deployment artifact must be built from the
# committed lockfile, otherwise every build resolves different dependency
# versions and the thesis cannot pin what actually ran.
RUN npm ci --omit=dev --no-audit --no-fund
