# Common portable Node 22 image for agent, research resource, and collector.
# Uses the lockfile to install the workload's production-only dependencies.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=8080 NODE_EXTRA_CA_CERTS=/usr/local/share/thesis-pilot-ca.pem
COPY package.json package-lock.json ./
COPY --chown=node:node certs/thesis-pilot-ca.pem /usr/local/share/thesis-pilot-ca.pem
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY --chown=node:node dist/ ./dist/
USER node
EXPOSE 8080
CMD ["node", "dist/agent.js"]
