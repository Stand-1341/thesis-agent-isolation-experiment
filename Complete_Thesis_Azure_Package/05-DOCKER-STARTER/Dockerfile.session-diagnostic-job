FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY --chown=node:node scripts/azure-session-header-job.mjs scripts/session-header-diagnostic.mjs scripts/session-endpoint.mjs scripts/azure-delegated-token.mjs ./scripts/
USER node
CMD ["node", "scripts/azure-session-header-job.mjs"]
