FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY --chown=node:node scripts/managed-audit-probe.mjs scripts/azure-managed-logs-token.mjs scripts/azure-storage-audit-reader.mjs scripts/blob-audit-observations.mjs ./scripts/
USER node
CMD ["node", "scripts/managed-audit-probe.mjs"]
