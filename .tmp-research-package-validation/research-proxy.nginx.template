# Candidate nginx server blocks. Replace both private IP placeholders after
# assigning the secondary address in Linux. Certificates must match the names
# used by clients and be trusted by controller and workloads; not self-provisioned.
server {
    listen __RESEARCH_PRIVATE_IP__:443 ssl;
    server_name _;
    ssl_certificate /etc/thesis-research/tls/research.crt;
    ssl_certificate_key /etc/thesis-research/tls/research.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_max_body_size 32k;
    location / { proxy_pass http://127.0.0.1:9000; proxy_set_header Host $host; proxy_connect_timeout 5s; proxy_read_timeout 15s; }
}
server {
    listen __COLLECTOR_PRIVATE_IP__:8443 ssl;
    server_name _;
    ssl_certificate /etc/thesis-research/tls/collector.crt;
    ssl_certificate_key /etc/thesis-research/tls/collector.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_max_body_size 32k;
    location / { proxy_pass http://127.0.0.1:9001; proxy_set_header Host $host; proxy_connect_timeout 5s; proxy_read_timeout 15s; }
}
server {
    listen __RESTRICTED_PRIVATE_IP__:9443 ssl;
    server_name _;
    ssl_certificate /etc/thesis-research/tls/restricted.crt;
    ssl_certificate_key /etc/thesis-research/tls/restricted.key;
